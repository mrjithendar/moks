{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustTheMoksExecutorRoleWithExternalId",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::111111111111:role/moks-executor"},
      "Action": "sts:AssumeRole",
      "Condition": {"StringEquals": {"sts:ExternalId": "REPLACE-WITH-connector-external_id"}}
    }
  ]
}
