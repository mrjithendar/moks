{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {"Service": "pods.eks.amazonaws.com"},
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Condition": {"StringEquals": {"aws:RequestTag/kubernetes-namespace": "moks", "aws:RequestTag/kubernetes-service-account": "moks-executor"}}
    }
  ]
}
